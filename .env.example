SPACE_ID=mrfakename/z-image-turbo
# Private Hugging Face Spaces need a token. Public Spaces can leave this empty.
# HF_TOKEN=your_hugging_face_token

# Public address used in image_url when the server runs behind a reverse proxy (for example https://proxy.example.com).
# PUBLIC_BASE_URL=

# Generated images in outputs/ are removed after this many seconds. 0 keeps them.
# OUTPUT_TTL_SECONDS=86400

# Folder where gradio_client downloads Space results. Only image files inside it are published.
# GRADIO_DOWNLOAD_DIR=downloads
